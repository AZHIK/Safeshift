{
  "name": "safeshift",
  "version": "0.1.0",
  "private": true,
  "description": "SafeShift logistics marketplace monorepo",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "corepack pnpm --filter @safeshift/shared-types build && corepack pnpm --filter @safeshift/web dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:start": "npx --yes supabase start",
    "db:stop": "npx --yes supabase stop",
    "db:reset": "npx --yes supabase db reset",
    "db:types": "npx --yes supabase gen types typescript --local --schema public > packages/shared-types/src/database.generated.ts",
    "db:verify": "bash scripts/verify-db.sh",
    "flutter:get": "melos bootstrap",
    "flutter:analyze": "melos run analyze",
    "flutter:test": "melos run test --no-select",
    "flutter:format": "melos run format",
    "setup": "bash scripts/bootstrap.sh",
    "check": "corepack pnpm typecheck && corepack pnpm lint && corepack pnpm build && corepack pnpm flutter:analyze && corepack pnpm flutter:test"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3"
  }
}
