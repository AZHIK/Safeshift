#!/usr/bin/env bash
# Copy to supabase/scripts/setup-vault-secrets.sh, chmod +x, and run locally.
# Never commit the filled copy. Production secrets are provisioned through the
# Supabase dashboard or a controlled CI secret, not from a developer laptop.
#
# Required environment variables:
#   CRON_SECRET
#   INTERNAL_FUNCTION_SECRET
#   SELCOM_API_KEY, SELCOM_API_SECRET, SELCOM_VENDOR_ID, SELCOM_WEBHOOK_SECRET
#   FLUTTERWAVE_SECRET_KEY, FLUTTERWAVE_WEBHOOK_SECRET
#   BEEM_API_KEY, BEEM_SECRET_KEY
#   AFRICASTALKING_USERNAME, AFRICASTALKING_API_KEY
#   RESEND_API_KEY
#   FCM_SERVICE_ACCOUNT_JSON
#   GOOGLE_MAPS_API_KEY

set -euo pipefail

DB_URL="${LOCAL_DB_URL:-postgresql://postgres:postgres@127.0.0.1:54322/postgres}"

: "${CRON_SECRET:?CRON_SECRET is required}"
: "${INTERNAL_FUNCTION_SECRET:?INTERNAL_FUNCTION_SECRET is required}"
: "${SELCOM_API_KEY:?SELCOM_API_KEY is required}"
: "${SELCOM_API_SECRET:?SELCOM_API_SECRET is required}"
: "${SELCOM_VENDOR_ID:?SELCOM_VENDOR_ID is required}"
: "${SELCOM_WEBHOOK_SECRET:?SELCOM_WEBHOOK_SECRET is required}"
: "${FLUTTERWAVE_SECRET_KEY:?FLUTTERWAVE_SECRET_KEY is required}"
: "${FLUTTERWAVE_WEBHOOK_SECRET:?FLUTTERWAVE_WEBHOOK_SECRET is required}"
: "${BEEM_API_KEY:?BEEM_API_KEY is required}"
: "${BEEM_SECRET_KEY:?BEEM_SECRET_KEY is required}"
: "${AFRICASTALKING_USERNAME:?AFRICASTALKING_USERNAME is required}"
: "${AFRICASTALKING_API_KEY:?AFRICASTALKING_API_KEY is required}"
: "${RESEND_API_KEY:?RESEND_API_KEY is required}"
: "${FCM_SERVICE_ACCOUNT_JSON:?FCM_SERVICE_ACCOUNT_JSON is required}"
: "${GOOGLE_MAPS_API_KEY:?GOOGLE_MAPS_API_KEY is required}"

psql "$DB_URL" -v ON_ERROR_STOP=1 \
  -v cron_secret="$CRON_SECRET" \
  -v internal_secret="$INTERNAL_FUNCTION_SECRET" \
  -v selcom_key="$SELCOM_API_KEY" \
  -v selcom_secret="$SELCOM_API_SECRET" \
  -v selcom_vendor="$SELCOM_VENDOR_ID" \
  -v selcom_webhook="$SELCOM_WEBHOOK_SECRET" \
  -v flutterwave_key="$FLUTTERWAVE_SECRET_KEY" \
  -v flutterwave_webhook="$FLUTTERWAVE_WEBHOOK_SECRET" \
  -v beem_key="$BEEM_API_KEY" \
  -v beem_secret="$BEEM_SECRET_KEY" \
  -v at_username="$AFRICASTALKING_USERNAME" \
  -v at_key="$AFRICASTALKING_API_KEY" \
  -v resend_key="$RESEND_API_KEY" \
  -v fcm_json="$FCM_SERVICE_ACCOUNT_JSON" \
  -v maps_key="$GOOGLE_MAPS_API_KEY" <<'SQL'
select vault.create_secret(:'cron_secret', 'CRON_SECRET', 'Phase 7 scheduled-function gate')
where not exists (select 1 from vault.secrets where name = 'CRON_SECRET');

select vault.create_secret(:'internal_secret', 'INTERNAL_FUNCTION_SECRET', 'Phase 7 internal function gate')
where not exists (select 1 from vault.secrets where name = 'INTERNAL_FUNCTION_SECRET');

select vault.create_secret(:'selcom_key', 'SELCOM_API_KEY', 'Selcom API key')
where not exists (select 1 from vault.secrets where name = 'SELCOM_API_KEY');

select vault.create_secret(:'selcom_secret', 'SELCOM_API_SECRET', 'Selcom API secret')
where not exists (select 1 from vault.secrets where name = 'SELCOM_API_SECRET');

select vault.create_secret(:'selcom_vendor', 'SELCOM_VENDOR_ID', 'Selcom vendor id')
where not exists (select 1 from vault.secrets where name = 'SELCOM_VENDOR_ID');

select vault.create_secret(:'selcom_webhook', 'SELCOM_WEBHOOK_SECRET', 'Selcom webhook signature secret')
where not exists (select 1 from vault.secrets where name = 'SELCOM_WEBHOOK_SECRET');

select vault.create_secret(:'flutterwave_key', 'FLUTTERWAVE_SECRET_KEY', 'Flutterwave secret key')
where not exists (select 1 from vault.secrets where name = 'FLUTTERWAVE_SECRET_KEY');

select vault.create_secret(:'flutterwave_webhook', 'FLUTTERWAVE_WEBHOOK_SECRET', 'Flutterwave webhook signature secret')
where not exists (select 1 from vault.secrets where name = 'FLUTTERWAVE_WEBHOOK_SECRET');

select vault.create_secret(:'beem_key', 'BEEM_API_KEY', 'Beem API key')
where not exists (select 1 from vault.secrets where name = 'BEEM_API_KEY');

select vault.create_secret(:'beem_secret', 'BEEM_SECRET_KEY', 'Beem secret key')
where not exists (select 1 from vault.secrets where name = 'BEEM_SECRET_KEY');

select vault.create_secret(:'at_username', 'AFRICASTALKING_USERNAME', 'Africa''s Talking username')
where not exists (select 1 from vault.secrets where name = 'AFRICASTALKING_USERNAME');

select vault.create_secret(:'at_key', 'AFRICASTALKING_API_KEY', 'Africa''s Talking API key')
where not exists (select 1 from vault.secrets where name = 'AFRICASTALKING_API_KEY');

select vault.create_secret(:'resend_key', 'RESEND_API_KEY', 'Resend API key')
where not exists (select 1 from vault.secrets where name = 'RESEND_API_KEY');

select vault.create_secret(:'fcm_json', 'FCM_SERVICE_ACCOUNT_JSON', 'Firebase service-account JSON')
where not exists (select 1 from vault.secrets where name = 'FCM_SERVICE_ACCOUNT_JSON');

select vault.create_secret(:'maps_key', 'GOOGLE_MAPS_API_KEY', 'Google Maps API key')
where not exists (select 1 from vault.secrets where name = 'GOOGLE_MAPS_API_KEY');
SQL

echo "Vault secrets created (existing names were left unchanged)."
echo "To rotate a secret, delete or update the corresponding vault.secrets row explicitly."
