# Copy to supabase/functions/.env.local and fill in local development values.
# Never commit the filled file. Production credentials belong in Supabase Vault.
#
# Supabase CLI injects SUPABASE_URL, SUPABASE_ANON_KEY, and
# SUPABASE_SERVICE_ROLE_KEY automatically when serving locally. Keep the
# explicit entries below only if you run the functions outside `supabase functions serve`.

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
# Public base used to rewrite signed Storage URLs returned by local Functions.
# The local runtime reaches Storage through http://kong:8000, which is not
# reachable from a developer machine.
PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Shared gates
CRON_SECRET=replace-with-a-long-random-value
INTERNAL_FUNCTION_SECRET=replace-with-a-different-long-random-value

# Selcom
SELCOM_API_KEY=replace-me
SELCOM_API_SECRET=replace-me
SELCOM_VENDOR_ID=replace-me
SELCOM_WEBHOOK_SECRET=replace-me
SELCOM_BASE_URL=https://sandbox.selcom.co.tz

# Flutterwave
FLUTTERWAVE_SECRET_KEY=replace-me
FLUTTERWAVE_WEBHOOK_SECRET=replace-me
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com

# Beem Africa (SMS)
BEEM_API_KEY=replace-me
BEEM_SECRET_KEY=replace-me
BEEM_SENDER_ID=SafeShift

# Africa's Talking (SMS fallback)
AFRICASTALKING_USERNAME=replace-me
AFRICASTALKING_API_KEY=replace-me
AFRICASTALKING_SENDER_ID=SafeShift

# Resend (email)
RESEND_API_KEY=replace-me
RESEND_FROM_EMAIL=notifications@safeshift.example

# Firebase Cloud Messaging (service-account JSON, one line)
FCM_PROJECT_ID=replace-me
FCM_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"replace-me"}

# Google Maps
GOOGLE_MAPS_API_KEY=replace-me
