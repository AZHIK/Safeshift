# SafeShift root environment template.
# Copy to .env for local backend/Edge Function work. Never commit real secrets.

# Supabase local defaults (Supabase CLI)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Next.js public values live in apps/web/.env.local
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Phase 7 provider placeholders
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
BEEM_API_KEY=
BEEM_SECRET_KEY=
RESEND_API_KEY=
SELCOM_API_KEY=
SELCOM_API_SECRET=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
