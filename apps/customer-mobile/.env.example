# SafeShift Customer — environment template.
# This file is a template only. Flutter does not read .env files at runtime;
# pass these values with --dart-define. Never commit secrets.
ENV=dev
SUPABASE_URL=
SUPABASE_ANON_KEY=
GOOGLE_MAPS_API_KEY=
# Optional Firebase push configuration. Leave blank to disable push locally.
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
# Design-only mock flows. Keep false for real backend testing.
MOCK_MODE=false
