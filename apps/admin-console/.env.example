NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# Two-factor methods offered on /mfa (comma-separated). The authenticator app
# is always offered. Add "sms" once MESEJI_API_KEY is set and "email" once
# BREVO_API_KEY / BREVO_SENDER are set on the Supabase project.
CONSOLE_2FA_METHODS=authenticator
